generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase : URL "Transaction pooler" (port 6543) pour l'application
  url       = env("DATABASE_URL")
  // Supabase : URL "Direct connection" (port 5432) pour prisma db push / migrate
  directUrl = env("DIRECT_URL")
}

// =====================================================================
//  COMPTES — necessaires pour la connexion Google (NextAuth)
// =====================================================================

enum Role {
  LICENCIE // par defaut : consultation seule
  DIRIGEANT // peut modifier matchs, actus, effectifs
  ADMIN // tout, + gestion des roles
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(LICENCIE)
  createdAt     DateTime  @default(now())

  // Preferences de notification
  notifyMatches Boolean @default(true) // prochains matchs de mes categories
  notifyResults Boolean @default(true) // resultats de mes categories
  notifyNews    Boolean @default(true) // actualites du club
  notifyEvents  Boolean @default(true) // evenements (loto, tournoi...)

  supporter Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  registrations Registration[]
  player        Player?
  joinRequest   JoinRequest?
  favorites     Team[]             @relation("UserFavorites")
  subscriptions PushSubscription[]
}

// Un navigateur/telephone abonne aux notifications.
// Un meme compte peut en avoir plusieurs (telephone + ordinateur).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================
//  LE CLUB — equipes, joueurs, encadrement, bureau
// =====================================================================

model Team {
  id          String  @id @default(cuid())
  name        String  @unique // "U14 · U15"
  slug        String  @unique // "u14-u15"
  order       Int     @default(0) // ordre d'affichage
  level       String? // "Football à 11"
  venue       String? // "Stade de Pinon"
  description String? @db.Text
  photo       String?

  // Informations pour rejoindre le club
  birthYears  String? // "2014-2015"
  trainDays   String? // "Mardi & Jeudi"
  trainHours  String? // "17h30-19h"
  restartDate String? // "Mardi 18 août"
  contactName String?
  contactTel  String? // visible seulement pour les personnes connectées

  players   Player[]
  staff     Staff[]
  matches   Match[]
  favoredBy User[]        @relation("UserFavorites")
  standing  StandingRow[]
  photos    Photo[]
  requests  JoinRequest[]
}

// Comment le nom d'un joueur apparait publiquement
enum NameDisplay {
  COMPLET // Sacha Nowak
  INITIALE // Sacha N.
  PRENOM // Sacha
}

model Player {
  id        String  @id @default(cuid())
  firstName String
  lastName  String  @default("")
  photo     String?
  position  String? // "Gardien", "Milieu"...
  number    Int?

  // Droit a l'image : reglages appliques sur les pages publiques
  publicPhoto Boolean     @default(true)
  nameDisplay NameDisplay @default(COMPLET)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Compte Google du joueur, s'il en a un
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

model Staff {
  id        String  @id @default(cuid())
  firstName String
  lastName  String  @default("")
  role      String  @default("Éducateur")
  photo     String?

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

enum BoardGroup {
  BUREAU // bureau directeur
  ANIMATION // bureau d'animation
  RESPONSABLE
  COMITE
}

model BoardMember {
  id        String     @id @default(cuid())
  firstName String
  lastName  String     @default("")
  role      String // "Présidente", "Trésorier"...
  group     BoardGroup @default(BUREAU)
  photo     String?
  order     Int        @default(0)
}

// =====================================================================
//  MATCHS — calendrier et resultats (le direct reste sur SportCorico)
// =====================================================================

enum Competition {
  CHAMPIONNAT
  COUPE
  AMICAL
  PLATEAU
}

model Match {
  id          String      @id @default(cuid())
  teamId      String
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  kickoff      DateTime
  opponent     String
  opponentLogo String?
  home        Boolean     @default(true)
  competition Competition @default(CHAMPIONNAT)
  venue       String?
  // resultat : laisser vide tant que le match n'est pas joue
  scoreFor     Int?
  scoreAgainst Int?
  notes        String?    @db.Text

  @@index([teamId, kickoff])
}

// =====================================================================
//  ACTUALITES
// =====================================================================

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  tag         String    @default("Club")
  excerpt     String    @db.Text
  body        String?   @db.Text
  image       String?
  publishedAt DateTime  @default(now())
  published   Boolean   @default(true)

  @@index([publishedAt])
}

// =====================================================================
//  CLASSEMENT — saisi par les dirigeants, une ligne par club
// =====================================================================

model StandingRow {
  id       String  @id @default(cuid())
  teamId   String
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position Int
  clubName String
  isUsap   Boolean @default(false)

  played       Int @default(0)
  won          Int @default(0)
  drawn        Int @default(0)
  lost         Int @default(0)
  goalsFor     Int @default(0)
  goalsAgainst Int @default(0)

  @@index([teamId, position])
}

// =====================================================================
//  GALERIE PHOTOS
// =====================================================================

model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  season    String   @default("2025/2026")
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([season, createdAt])
}

// =====================================================================
//  PARTENAIRES
// =====================================================================

enum PartnerTier {
  PRINCIPAL
  OFFICIEL
  SUPPORTER
}

model Partner {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  logo        String?
  website     String?
  description String?     @db.Text
  address     String? // sert a afficher la carte
  tier        PartnerTier @default(OFFICIEL)
  order       Int         @default(0)
  visible     Boolean     @default(true)
}

// =====================================================================
//  EVENEMENTS DU CLUB (loto, tournoi, assemblee generale...)
// =====================================================================

model Event {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?  @db.Text
  startsAt     DateTime
  place        String?
  image        String?
  openToSignup Boolean  @default(true)
  capacity     Int? // laisser vide = pas de limite
  published    Boolean  @default(true)

  registrations Registration[]

  @@index([startsAt])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  people    Int      @default(1)
  comment   String?
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

// =====================================================================
//  DEMANDES POUR REJOINDRE LE CLUB
//  Le licencie remplit sa fiche, un dirigeant valide.
// =====================================================================

enum RequestStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

model JoinRequest {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String        @default("")
  photo     String?
  // Soit une categorie de jeu, soit supporter
  teamId    String?
  team      Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  supporter Boolean       @default(false)
  message   String?

  status    RequestStatus @default(EN_ATTENTE)
  reason    String?
  createdAt DateTime      @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
}
